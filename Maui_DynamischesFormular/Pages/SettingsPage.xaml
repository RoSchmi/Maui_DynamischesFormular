        <DataTemplate x:Key="stringTypeDontShowTemplate">
            <Grid Padding="0,0">

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="boolTypeTemplate">
            <Grid Padding="10">
                <Frame HeightRequest="80">
                    <Grid>
                        <HorizontalStackLayout VerticalOptions="Center" Grid.Column="0" Padding="0">
                            <!--<Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" FontAttributes="Bold" />
                            <CheckBox IsChecked="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=BoolValue}" Margin="20, 0, 0, 0"/>-->
                            <Label Text="Bool" Margin="20, 0, 0, 0" FontSize="15"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="boolTypeReadOnlyTemplate">
            <Grid Padding="10">
                <Frame HeightRequest="80">
                    <Grid>
                        <HorizontalStackLayout VerticalOptions="Center" Grid.Column="0" Padding="0">
                            <!--<Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" FontAttributes="Bold" />
                            <CheckBox IsChecked="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=BoolValue}" IsEnabled="False" Margin="20, 0, 0, 0"/>-->
                            <Label Text="Bool" Margin="20, 0, 0, 0" FontSize="15"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="boolTypeDontShowTemplate">
            <Grid   Padding="0,0">

            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="dateTypeTemplate">
            <Grid Padding="10">
                <Frame HeightRequest="70">
                    <Grid>
                        <HorizontalStackLayout VerticalOptions="Center" Grid.Column="0" Padding="0">
                            <!--<Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" FontAttributes="Bold" />
                            <DatePicker Date="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=DateValue}" Margin="20, 0, 0, 0"/>-->
                            <Label Text="Date" Margin="20, 0, 0, 0" FontSize="15"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="dateTypeReadOnlyTemplate">
            <Grid Padding="10">
                <Frame HeightRequest="70">
                    <Grid>
                        <HorizontalStackLayout VerticalOptions="Center" Grid.Column="0" Padding="0">
                            <!--<Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" FontAttributes="Bold" />
                            <DatePicker Date="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=DateValue}" IsEnabled="False" Margin="20, 0, 0, 0"/>-->
                            <Label Text="Date" Margin="20, 0, 0, 0" FontSize="15"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="dateTypeDontShowTemplate">
            <Grid Padding="0,0">

            </Grid>
        </DataTemplate>

        <templates:TypeDataTemplateSelector x:Key="typeDataTemplateSelector"
                                          StringTypeTemplate="{StaticResource stringTypeTemplate}"
                                          StringTypeReadOnlyTemplate="{StaticResource stringTypeReadOnlyTemplate}" 
                                          StringTypeDontShowTemplate="{StaticResource stringTypeDontShowTemplate}"
                                          StringTypeSwipeTemplate="{StaticResource stringTypeSwipeTemplate}"
                                          BoolTypeTemplate="{StaticResource boolTypeTemplate}"
                                          BoolTypeReadOnlyTemplate="{StaticResource boolTypeReadOnlyTemplate}"
                                          BoolTypeDontShowTemplate="{StaticResource boolTypeDontShowTemplate}"                                           
                                          DateTypeTemplate="{StaticResource dateTypeTemplate}"
                                          DateTypeDontShowTemplate="{StaticResource dateTypeDontShowTemplate}"   
                                          DateTypeReadOnlyTemplate="{StaticResource dateTypeReadOnlyTemplate}"/>

    </ContentPage.Resources>
    <ContentPage.Content>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*, *, *" Margin="0,2,0,0" RowDefinitions="40, 4">

                <Button Text="{Binding SettingsPageRightCommand}" IsVisible="{Binding SettingsPageRightCommandIsVisible}"  TextColor="DeepSkyBlue" FontAttributes="Bold"  BackgroundColor="Transparent" BorderWidth="0"  Command="{Binding ButtonSettingsRightCommandClickedCommand}" MaximumHeightRequest="40" Grid.Column="2"  HorizontalOptions="End"/>
                <Button Text="Debug"  Margin="10,0,0,0" BorderWidth="0" Command="{Binding Button_Debug_clicked_Command}" TextColor="DeepSkyBlue" MaximumHeightRequest="40" FontAttributes="Bold"  BackgroundColor="Transparent" Grid.Column="1" HorizontalOptions="Start"/>
                <Button Text="{Binding SettingsPageLeftCommand}" IsVisible="{Binding SettingsPageLeftCommandIsVisible}" TextColor="DeepSkyBlue" FontAttributes="Bold" BackgroundColor="Transparent" BorderWidth="0" Command="{Binding ButtonSettingsLeftCommandClickedCommand}" MaximumHeightRequest="40" Grid.Column="0" HorizontalOptions="Start"/>
        
                <BoxView Grid.Row="1" Grid.ColumnSpan="3" Color="LightGray" HeightRequest="3" HorizontalOptions="Fill" />
               
            </Grid>
            
            <VerticalStackLayout x:Name="AccountsStacklayout"  Margin="10,0,0,0" IsVisible="{Binding AccountsStacklayoutVisible}">
                <Label Text="New Storage Account" Margin="0,10,0,0" HorizontalOptions="Start" FontSize="Micro"/>
                <Grid MinimumHeightRequest="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="98*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Entry Text="{Binding AccountEntry}" Placeholder="Enter Account here" IsTextPredictionEnabled="False" BackgroundColor="AliceBlue" TextColor="DarkGray" FontSize="Small" Grid.Column="0" HorizontalOptions="Fill"/>
                    <Button Text="" Grid.Column="1" HorizontalOptions="Fill" FontSize="Micro" Margin="0,0,0,0" BackgroundColor="LightGray" />
                </Grid>
                <!--<Entry Text="{Binding Account}" FontSize="Small" TextColor="DarkGray" MinimumHeightRequest="60" BackgroundColor="AliceBlue"/>-->
                <Label Text="New Storage Key" HorizontalOptions="Start" Margin="0,10,0,0" FontSize="Micro"/>
                <Grid MinimumHeightRequest="40" ColumnDefinitions="80*,20*">

                    <Entry Text="{Binding KeyEntry}" Placeholder="Enter Key here" IsTextPredictionEnabled="False" BackgroundColor="AliceBlue" TextColor="DarkGray" FontSize="Small" Grid.Column="0" HorizontalOptions="Fill" />
                    <Button Text="Help"  Command="{Binding Button_Tip_clicked_Command}"  Grid.Column="1" HorizontalOptions="Fill" FontSize="Micro" Margin="0,0,3,0" BackgroundColor="OrangeRed" />
                </Grid>
                <Button Text="Add arbitrary Credentials" IsVisible="false" HorizontalOptions="Start" Command="{Binding Button_AddAbitrary_clicked_Command}"  BorderColor="Gray" BorderWidth="1"/>
                <Button Text="Apply entered Credentials" Margin=" 0,5,0,0" HorizontalOptions="Start" Command="{Binding Button_AddCredentials_clicked_Command}"  BorderColor="Gray" BorderWidth="1"/>
                <Button Text="{Binding AppearCounter}" Padding="5, 5" HorizontalOptions="Start" Command="{Binding Button_PupulateCommand}"  BorderColor="Gray" BorderWidth="1"/>
                <HorizontalStackLayout>
                    <Label  Text="Selected Account: " VerticalOptions="Center"/>
                    <Label  Text="{Binding SelectedAccount}" TextColor="DarkGray" Padding="5, 5" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Grid HorizontalOptions="StartAndExpand" RowDefinitions="40,Auto" MaximumWidthRequest="300">
                        <Button Text="Test Connection" Grid.Row="0" Frame="0, -4, 0, 0" HorizontalOptions="Start" MaximumHeightRequest="35" Command="{Binding ButtonTestConnectionClickedCommand}" TextColor="DeepSkyBlue" BackgroundColor="Transparent" BorderWidth="0"/>
                        <Label  Grid.Row="1"  HeightRequest="6" Frame="0, -4, 0, 0"  BackgroundColor="{Binding ConnectionOKBackGround}"/>
                    </Grid>
                </HorizontalStackLayout>
                <!-- <Label Text="Credentials: Select / Delete" Margin="0, 10, 0, 0" FontAttributes="Bold" HorizontalOptions="Start"/> -->
                <VerticalStackLayout>
                    <Grid RowDefinitions="300, 1" VerticalOptions="FillAndExpand">
                        <TableView  x:Name="TableViewAccounts">
                        </TableView>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
            
            <VerticalStackLayout x:Name="SettingStacklayout" IsVisible="{Binding SettingsStacklayoutVisible}">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto">
                    <VerticalStackLayout Grid.Row="0">
                        <HorizontalStackLayout IsVisible="{Binding NavStateRowIsVisible}">
                            <Label Text="Injected: " FontSize="Medium" Margin="10, 10, 0, 0"/>
                            <Label Text="{Binding SenderMessage}" FontAttributes="Bold" TextColor="DarkViolet" FontSize="Medium" Margin="10, 10, 0, 0"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout IsVisible="{Binding NavStateRowIsVisible}">
                            <Label Text="NavState: " Padding="5,0"  HorizontalOptions="Start" VerticalOptions="Start" FontSize="Small" FontAttributes="None" MaximumHeightRequest="25"/>
                            <Label Text="{Binding NavigationState}" Margin="0,0,0,5" MinimumWidthRequest="200" BackgroundColor="DarkGray" MaximumHeightRequest="25"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout IsVisible="{Binding NavStateRowIsVisible}">
                            <Button Text="&lt; ShowGraphs" HorizontalOptions="Start"  Command="{Binding ShowGraphsCommand}" />
                            <Button Text="Save Changes" Command="{Binding ButtonSaveChangesClickedCommand}" Margin="5,0,10,0" BorderWidth ="{Binding SaveButtonBorderWidth}" HorizontalOptions="End" TextColor="Blue" />
                            <Button Text="Debug" Command="{Binding Button_Debug_clicked_Command}" Margin="5,0,10,0" HorizontalOptions="End" TextColor="Blue" />

                        </HorizontalStackLayout>
                        
                        <Grid Grid.Row="3" ColumnDefinitions="30*, 20*, 20*,20*, 20*" RowDefinitions="Auto, Auto, Auto, Auto">
                            <Label Text="Click to Select Profile" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"/>
                            <Label Text="Rename, Add or Delete" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,10,0,0"/>
                            <Picker Margin="0,5,10,5" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="Red" MinimumWidthRequest="200" ItemsSource="{Binding ProfileNames}" SelectedIndex="{Binding SelectedProfileIndex}" />
                            <Button Text="Ren" Margin="5,5,10,5" MinimumWidthRequest="70" Grid.Column="2" Grid.Row="1" Command="{Binding ButtonRenProfileClickedCommand}"/>
                            <Button Text="Add" Margin="5,5,10,5" MinimumWidthRequest="70" Grid.Column="3" Grid.Row="1" Command="{Binding ButtonAddProfileClickedCommand}"/>
                            <Button Text="Del" Margin="5,5,10,5" MinimumWidthRequest="70" Grid.Column="4" Grid.Row="1" Command="{Binding ButtonDelProfileClickedCommand}"/>
                            <BoxView Grid.Row="2" Grid.ColumnSpan="5" Color="LightGray" HeightRequest="3" HorizontalOptions="Fill" />
                            
                        </Grid>
                        <ScrollView Grid.Row="3" Background="CadetBlue"  VerticalScrollBarVisibility="Always" HorizontalScrollBarVisibility="Always">
                            <VerticalStackLayout BackgroundColor="LightGreen" Padding="5,5" >
                                <CollectionView x:Name="collectionView" ItemsSource="{Binding Path=WorkItemCollection}"  SelectionMode="Single" ItemTemplate="{StaticResource typeDataTemplateSelector}"/>
                            </VerticalStackLayout>
                        </ScrollView>


                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" x:Name="Rename_StackLauout" IsVisible="{Binding Rename_StackLayout_IsVisible}">
                        <Label Text="{Binding Rename_Command_Header}" VerticalOptions="End"  TextColor="Red" HorizontalOptions="CenterAndExpand" FontSize="Header" IsEnabled="False"/>
                        <Label Text="Actual Profilename:" HorizontalOptions="StartAndExpand" FontSize="Micro" TextColor="Red"/>
                        <Entry Text="{Binding SelectedProfile}" IsReadOnly="True"/>
                        <Label Text="New Profilename:" HorizontalOptions="StartAndExpand" FontSize="Micro" TextColor="Red"/>
                        <Entry Text="{Binding NewProfileName}" Placeholder="Enter new Profilename"/>
                        <HorizontalStackLayout>
                            <Button Text=" Cancel " Margin="20,0,20,0" BorderWidth="1" BorderColor="DarkGray" HorizontalOptions="CenterAndExpand" Command="{Binding Button_RenProfile_Cancel_clicked_Command}"/>
                            <Button Text=" Accept " Margin="20,0,20,0" BorderWidth="1" BorderColor="DarkGray" HorizontalOptions="CenterAndExpand" Command="{Binding Button_RenProfile_Accept_clicked_Command}"/>
                        </HorizontalStackLayout>

                        <Label HeightRequest="4" BackgroundColor="LightGray" HorizontalOptions="FillAndExpand" IsEnabled="False"/>
                        <Label Text="" HorizontalOptions="StartAndExpand" Margin="0,10,0,10"/>
                    </VerticalStackLayout>
                    
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ContentPage.Content>

</ContentPage>
