<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui_DynamischesFormular.Pages.SettingsPage"
             xmlns:viewmodel="clr-namespace:Maui_DynamischesFormular.ViewModels"
             xmlns:local="clr-namespace:Maui_DynamischesFormular"
             xmlns:templates="clr-namespace:DataTemplates"
             xmlns:controls="clr-namespace:Maui_DynamischesFormular.Controls"
             xmlns:models="clr-namespace:Maui_DynamischesFormular.Models"             
             x:DataType="viewmodel:SettingsViewModel"
             Shell.FlyoutBehavior="Disabled">
    
    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding BackCommand}" CommandParameter="Hallo" IsVisible="False" IsEnabled="False"/>
    </Shell.BackButtonBehavior>
    <ContentPage.Resources>
        <Style TargetType="SwipeView">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" >
                            <VisualState.Setters>
                                <Setter TargetName="myboxview" Property="BoxView.Color" Value="DarkGray" />
                                <Setter TargetName="myframe" Property="Frame.BorderColor" Value="DarkGray" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter TargetName="myboxview" Property="BoxView.Color" Value="Red" />
                                <Setter TargetName="myframe" Property="Frame.BorderColor" Value="Red" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <ControlTemplate x:Key="CardViewFlatControlTemplate">
            <Frame BindingContext="{Binding Source={RelativeSource TemplatedParent}}"
                   BackgroundColor="{Binding CardColor}"
                   Opacity="0.8"
                   BorderColor="{Binding BorderColor}"               
                   CornerRadius="5"
                   HasShadow="True"
                   Padding="8"
                   HorizontalOptions="Fill"                 
                   VerticalOptions="Center">
                <!-- HorizontalOptions="Center" -->
                <!-- WidthRequest="400"-->
                <Grid ColumnDefinitions="30*, 70*" MinimumHeightRequest="15">
                    <Label Text="{Binding CardTitle}"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start" Grid.Column="0"/>
                    <Label Text="{Binding CardDescription}"
                           FontAttributes="Bold"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start" Grid.Column="1"/>
                </Grid>

            </Frame>
        </ControlTemplate>
        <ControlTemplate x:Key="CardViewControlTemplate">
            <Frame BindingContext="{Binding Source={RelativeSource TemplatedParent}}"
                   BackgroundColor="{Binding CardColor}"
                   Opacity="0.8"
                   BorderColor="{Binding BorderColor}"               
                   CornerRadius="5"
                   HasShadow="True"
                   Padding="8"
                   HorizontalOptions="Fill"                 
                   VerticalOptions="Center">
                <!-- HorizontalOptions="Center" -->
                <!-- WidthRequest="400"-->

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Text="{Binding CardTitle}"
                           FontAttributes="Bold"
                           FontSize="20"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start" />
                    <BoxView Grid.Row="1"
                             BackgroundColor="{Binding BorderColor}"
                             HeightRequest="2"
                             HorizontalOptions="Fill" />
                    <Label Grid.Row="2"
                           Text="{Binding CardDescription}"
                           VerticalTextAlignment="Start"
                           VerticalOptions="Fill"
                           HorizontalOptions="Fill" />
                </Grid>
            </Frame>
        </ControlTemplate>

        <DataTemplate x:Key="stringTypeTemplate">
            <Grid Padding="10">
                <Frame HeightRequest="70">
                    <Grid>
                        <HorizontalStackLayout VerticalOptions="Center" Grid.Column="0" Padding="0">
                            <!--<Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" VerticalOptions="Center" FontAttributes="Bold"/>
                            <Entry Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=StringValue}" Margin="20, 0, 0, 0" BackgroundColor ="Bisque" TextColor="Black"  FontAttributes="Bold" />-->
                            <Label Text="String" Margin="20, 0, 0, 0" FontSize="15"/>
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="stringTypeReadOnlyTemplate">
            <controls:CardView BorderColor="DarkGray"
                               CardColor="Transparent"
                               CardTitle="{Binding Name}" 
                               CardDescription="{Binding StringValue}"
                               Padding="10, 0"
                               ControlTemplate="{StaticResource CardViewFlatControlTemplate}">

            </controls:CardView>

            <!-- <Grid Padding="10" ColumnDefinitions="50*, 50*"> -->
            <!--   <Frame HeightRequest="70"> -->
            <!--       <Grid> -->
            <!--            <HorizontalStackLayout VerticalOptions="Center" Grid.Column="0" Padding="0"> -->
            <!--                <Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" VerticalOptions="Center" FontAttributes="Bold" TextColor="DeepSkyBlue"/> -->
            <!--                <Entry Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=StringValue}" Margin="20, 0, 0, 0" TextColor="DarkGray" IsReadOnly="True" FontAttributes="Bold" /> -->
            <!--                <Label Text="String" Margin="20, 0, 0, 0" FontSize="15"/> -->
            <!--                </HorizontalStackLayout> -->
            <!--                                        -->
            <!-- </Grid> -->
            <!-- </Frame> -->
            <!-- </Grid> -->

        </DataTemplate>

