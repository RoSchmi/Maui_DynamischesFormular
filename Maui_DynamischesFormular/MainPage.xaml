<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui_DynamischesFormular"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewmodels="clr-namespace:Maui_DynamischesFormular.ViewModels"
             xmlns:models="clr-namespace:Maui_DynamischesFormular.Models"
             x:Class="Maui_DynamischesFormular.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="Home">

    <!-- :DataType="viewmodels:MainPageViewModel" -->



    <ContentPage.Resources>

       <!-- <DataTemplate x:Key="TextTemplate" x:DataType="models:TextItem">
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="{Binding LabelText}" />
                <Entry Text="{Binding Value}" Grid.Column="1" />
            </Grid> 
        </DataTemplate> --> 
        <DataTemplate x:Key="TextTemplateReadOnly" x:DataType="models:TextItem">
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="{Binding LabelText}" />
                <Entry Text="{Binding Value}" IsReadOnly="True"  Grid.Column="1" />
            </Grid>
        </DataTemplate>
        <!--<DataTemplate x:Key="BoolTemplate" x:DataType="models:BooleanItem">
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="{Binding LabelText}" />
                <CheckBox IsChecked="{Binding Value}" Grid.Column="1" />
            </Grid>
        </DataTemplate> -->
        <DataTemplate x:Key="BoolTemplateReadOnly" x:DataType="models:BooleanItem">
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="{Binding LabelText}" />
                <CheckBox IsChecked="{Binding Value}" IsEnabled="false" Grid.Column="1" />
            </Grid>
        </DataTemplate>

        <!-- <DataTemplate x:Key="DateTemplate" x:DataType="models:DateItem">
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="{Binding LabelText}" />
                <DatePicker Date="{Binding Value}"  FontAttributes="Bold" Grid.Column="1" />
            </Grid>
        </DataTemplate> -->
        <DataTemplate x:Key="DateTemplateReadOnly" x:DataType="models:DateItem">
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="{Binding LabelText}" />
                <DatePicker Date="{Binding Value}"  FontAttributes="Bold" IsEnabled="False" Grid.Column="1" />
            </Grid>
        </DataTemplate>

        <local:ItemTemplateSelector x:Key="ReadOnlyItemSelector"
                TextTemplate="{StaticResource TextTemplateReadOnly}"
                BoolTemplate="{StaticResource BoolTemplateReadOnly}"
                DateTemplate="{StaticResource DateTemplateReadOnly}" />
        <!-- 
        <local:ItemTemplateSelector x:Key="EditableItemSelector"
        TextTemplate="{StaticResource TextTemplate}"
        BoolTemplate="{StaticResource BoolTemplate}"
        DateTemplate="{StaticResource DateTemplate}" /> 
        -->



    </ContentPage.Resources>


    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="Hello, World!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Welcome to &#10;.NET Multi-platform App UI"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to dot net Multi platform App U I" />

            <Button
                x:Name="CounterBtn"
                Text="Congratulations: Use Hamburger Menue on the upper left side to navigate" 
                SemanticProperties.Hint="Counts the number of times you clicks"             
                HorizontalOptions="Fill" />
            <Grid  ColumnDefinitions="*,*,*,*,*">
                <Button
                    x:Name="Btn2"
                    Grid.Column="1"
                    Text="Go to Settings Page" 
                    SemanticProperties.Hint="Going to Settings Page"             
                    HorizontalOptions="Center"
                    Command="{Binding Button2ClickedCommand}"
                    CommandParameter="true"/>
                <Button
                    x:Name="Btn3"
                    Grid.Column="3"
                    Text="Go to Persons Edit Page" 
                    SemanticProperties.Hint="Going to Person Edit Page"             
                    HorizontalOptions="Center"
                    Command="{Binding Button3ClickedCommand}"
                    CommandParameter="true"/>
            </Grid>
            
            <HorizontalStackLayout>
                
            </HorizontalStackLayout>
            <Grid ColumnDefinitions="*,2*" Padding="10">
                <Label Text="Auswahl" FontAttributes="Bold"/>
                <Picker Grid.Column="1" MaximumWidthRequest="400" HorizontalOptions="Start" ItemsSource="{Binding PersonRecords}"
                    SelectedItem="{Binding SelectedRecord}"  
                    ItemDisplayBinding="{Binding PersonGuid}"/>
            </Grid>
            <CollectionView ItemsSource="{Binding SelectedRecord.Items}" ItemTemplate="{StaticResource ReadOnlyItemSelector}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
