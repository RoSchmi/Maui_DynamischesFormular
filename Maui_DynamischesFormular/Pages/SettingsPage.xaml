            <SwipeView x:Name="myswipeview"  Margin ="5,0,15,0">
                <Frame HeightRequest="98" x:Name="myframe">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1"                       
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:SettingsViewModel}}, 
                                                        Path=TapCommand}"
                                                        CommandParameter="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="60*, 35*, 5*" RowDefinitions="*,*,*">
                            <Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=Name}" Grid.Column="0" Grid.Row="0"  HorizontalOptions="Start" TextColor="DarkGoldenrod" FontAttributes="Bold"/>
                            <Label Text="Set Details  >" Grid.Column="1" Grid.Row="1" VerticalOptions="Center" HorizontalOptions="End" TextColor="DeepSkyBlue" FontAttributes="Bold"/>
                        
                            <HorizontalStackLayout Grid.Row="2">
                                <Label Text="CloudTableName:" HorizontalOptions="Start" FontAttributes="Bold"/>
                                <Label Text="{Binding Source={RelativeSource AncestorType={x:Type models:WorkItem}}, Path=StringValue}" HorizontalOptions="Start" Margin="5, 0, 0, 0" TextColor="Gray" />
                            </HorizontalStackLayout>
                        </Grid>
                        <BoxView x:Name="myboxview" Color="LightGray" HeightRequest="3" HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Frame>
            </SwipeView>
        </DataTemplate>
