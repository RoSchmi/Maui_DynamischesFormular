<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui_DynamischesFormular.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui_DynamischesFormular"
    xmlns:view="clr-namespace:Maui_DynamischesFormular.Pages"
    xmlns:viewmodels="clr-namespace:Maui_DynamischesFormular.ViewModels"
    x:DataType="viewmodels:SettingsViewModel"
    FlyoutBehavior="Flyout">


    <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" 
            FlyoutItemIsVisible="True"/>
     <ShellContent
            Title="SettingsPage"
            ContentTemplate="{DataTemplate view:SettingsPage}"
            Route="SettingsPage" 
            FlyoutItemIsVisible="True"/>
    <ShellContent
            Title="ProfileDetailPage"
            ContentTemplate="{DataTemplate view:ProfileDetailPage}"
            Route="ProfileDetailPage"    
            FlyoutItemIsVisible="False"
            IsVisible="False"/>
    <ShellContent
            Title="ShadowFilePage"
            ContentTemplate="{DataTemplate view:ShadowFilePage}"
            Route="ShadowFilePage"    
            FlyoutItemIsVisible="False"/>
    

</Shell>
    

